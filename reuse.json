    {
      "group": "Inference with a temperature: creative work needs variety, where legal work is held at 0. The default stays 0, so the change can go back into ELI Legal unchanged in behaviour.",
      "from": "ELI_Legal",
      "rewrite": [
        "legal"
      ],
      "mode": "copy",
      "items": [
        [
          "src/eli_legal/adapters/inference/gguf.py",
          "src/eli_creation/adapters/inference/gguf.py",
          [
            {
              "old": "        self, *, system: str, prompt: str, max_tokens: int = 2048, json_mode: bool = False\n    ) -> str:\n        loaded = self._loaded()\n        kwargs: dict[str, Any] = {\"max_tokens\": max_tokens, \"temperature\": 0.0}",
              "new": "        self, *, system: str, prompt: str, max_tokens: int = 2048, json_mode: bool = False,\n        temperature: float = 0.0,\n    ) -> str:\n        loaded = self._loaded()\n        kwargs: dict[str, Any] = {\"max_tokens\": max_tokens, \"temperature\": temperature}",
              "why": "a temperature for creative generation"
            }
          ]
        ],
        [
          "src/eli_legal/adapters/inference/local.py",
          "src/eli_creation/adapters/inference/local.py",
          [
            {
              "old": "        self, *, system: str, prompt: str, max_tokens: int = 2048, json_mode: bool = False\n    ) -> str:\n        body: dict[str, Any] = {",
              "new": "        self, *, system: str, prompt: str, max_tokens: int = 2048, json_mode: bool = False,\n        temperature: float = 0.0,\n    ) -> str:\n        body: dict[str, Any] = {",
              "why": "a temperature for creative generation"
            },
            {
              "old": "            \"temperature\": 0,\n            \"seed\": self.seed,",
              "new": "            \"temperature\": temperature,\n            \"seed\": self.seed,",
              "why": "a temperature for creative generation"
            }
          ]
        ],
        [
          "src/eli_legal/adapters/eli_v3/inference.py",
          "src/eli_creation/adapters/eli_v3/inference.py",
          [
            {
              "old": "        self, *, system: str, prompt: str, max_tokens: int = 2048, json_mode: bool = False\n    ) -> str:\n        if not self._fits(system, prompt):",
              "new": "        self, *, system: str, prompt: str, max_tokens: int = 2048, json_mode: bool = False,\n        temperature: float = 0.0,\n    ) -> str:\n        if not self._fits(system, prompt):",
              "why": "a temperature for creative generation"
            },
            {
              "old": "        options: dict[str, Any] = {\"max_tokens\": max_tokens, \"temperature\": 0.0}",
              "new": "        options: dict[str, Any] = {\"max_tokens\": max_tokens, \"temperature\": temperature}",
              "why": "a temperature for creative generation"
            }
          ]
        ],
        [
          "src/eli_legal/adapters/eli_v3/compat.py",
          "src/eli_creation/adapters/eli_v3/compat.py",
          [
            {
              "old": "        \"eli.cognition.gguf_inference\",\n        \"eli.core.netguard\",\n        \"eli.tools.registry.capability_registry\",",
              "new": "        \"eli.cognition.gguf_inference\",\n        \"eli.core.netguard\",\n        \"eli.tools.registry.capability_registry\",\n        # Creation Station also reads the machine, the licence products, and ELI's own eyes,\n        # attention and world, so ELI in the studio is the same ELI, not a second mind.\n        \"eli.core.hardware_profile\",\n        \"eli.licensing.products\",\n        \"eli.perception.os_controller\",\n        \"eli.perception.screen_analysis\",\n        \"eli.perception.vision\",\n        \"eli.perception.conversation\",\n        \"eli.planning.attention_queue\",\n        \"eli.planning.insight_synthesis\",\n        \"eli.world.games\",\n        \"eli.world.building\",",
              "why": "the ELI v3 modules Creation Station may use when ELI v3 hosts it"
            }
          ]
        ]
      ]
    },
