{
  "about": "The code ELI Creation Station takes from the other ELI products rather than writing again. scripts/sync_reused.py copies each file below from its product, applies the renames and patches listed, and records the product's commit in reuse.lock.json. mode copy: regenerated by every sync, never edited here (change it in its product). mode adapted: written once from the original and then edited here; --check reports when the original changes, to be merged by hand.",
  "sources": {
    "ELI_Legal": {
      "env": "ELI_LEGAL_SRC",
      "default": "../ELI_Legal",
      "repo": "ShadowESC95/ELI_Legal"
    },
    "ELI_v3.0": {
      "env": "ELI_V3_SRC",
      "default": "../ELI_v3.0",
      "repo": "ShadowESC95/ELI_v3.0"
    },
    "ELI_VR": {
      "env": "ELI_VR_SRC",
      "default": "../ELI_VR",
      "repo": "ShadowESC95/ELI_VR"
    }
  },
  "rewrites": {
    "legal": [
      [
        "ELI_LEGAL_",
        "ELI_CREATION_"
      ],
      [
        "EliLegalError",
        "EliCreationError"
      ],
      [
        "eli_legal",
        "eli_creation"
      ],
      [
        "eli-legal",
        "eli-creation"
      ],
      [
        "legal.eli.desktop",
        "creation.eli.desktop"
      ],
      [
        "ELI Legal",
        "ELI Creation Station"
      ]
    ],
    "core-log": [
      [
        "from eli.utils.log import get_logger  # type: ignore",
        "from logging import getLogger as get_logger"
      ],
      [
        "from eli.utils.log import get_logger",
        "from logging import getLogger as get_logger"
      ]
    ],
    "core-image": [
      [
        "eli.tools.image_engine.runtime_paths",
        "eli_creation.engines.image_paths"
      ],
      [
        "eli.tools.image_engine.image_engine",
        "eli_creation.engines.image_engine"
      ]
    ],
    "core-coding": [
      [
        "eli.core.dag",
        "eli_creation.coding.dag"
      ],
      [
        "eli.coding",
        "eli_creation.coding"
      ]
    ]
  },
