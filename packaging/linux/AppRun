#!/bin/sh
# Adapted from ELI_Legal: packaging/linux/AppRun @ 3b05ccd88f. Edited for ELI Creation Station; scripts/sync_reused.py --check says when the original changes.
# ELI Creation Station as an AppImage. With no arguments it opens the desktop application; with arguments it
# is the command line and the server (for example: ELI_Legal.AppImage serve --help).
HERE="$(dirname "$(readlink -f "$0")")"
if [ $# -eq 0 ]; then
  exec "$HERE/usr/lib/eli-creation/eli-creation-gui"
fi
exec "$HERE/usr/lib/eli-creation/eli-creation" "$@"
